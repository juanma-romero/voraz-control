# Ignorar todo lo que está en la raíz.
# Los repos de cada servicio viven adentro y tienen su propio .git, así que no
# se versionan desde acá.
/*
# El .gitignore sí se versiona
!.gitignore

# Documentación y configuración del proyecto (esto SÍ se versiona)
!/AGENTS.md
!/docs/
!/docs/**
!/docker-compose.yml
!/docker-compose.local.yml
!/dev.sh
!/.env.example

# Los .env reales (.env, .env.local) quedan ignorados por /* — nunca se versionan.
