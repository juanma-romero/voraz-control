# Plantilla de variables del stack Voraz. Copiar a .env y completar.
# Los valores reales NUNCA se versionan.

COMPOSE_PROJECT_NAME=

# --- backend ---
MONGODB_URI=                 # string de conexión a MongoDB (Atlas o local)
CHATWOOT_INBOX_IDENTIFIER=
CHATWOOT_API_TOKEN=

# --- dashWhat2 (WhatsApp / Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- erp-service (en erp-service/.env) ---
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ACCOUNT_CASH=
ACCOUNT_GASTO=

# --- ia-service (en ia-service/.env) ---
GOOGLE_API_KEY=
GROQ_API_KEY=
OPEN_ROUTER_API_KEY=
